OPENAI_URL=https://your-resource.openai.azure.com/
OPENAI_KEY=your-openai-key
API_KEY=replace-with-a-long-random-token
OPENAI_MODEL=gpt-4o
OPENAI_DEPLOYMENT_NAME=gpt-4o
OPENAI_API_VERSION=2024-10-21

SEARCH_URL=https://your-search-service.search.windows.net/
SEARCH_KEY=your-search-key
INDEX_NAME=your-index

EMBEDDING_MODEL=text-embedding-ada-002
EMBEDDING_DEPLOYMENT_NAME=text-embedding-ada-002
EMBEDDING_DIMENSIONS=1536

DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-document-intelligence.cognitiveservices.azure.com/
DOCUMENT_INTELLIGENCE_KEY=your-document-intelligence-key
ENABLE_VISION=false
VISION_DEPLOYMENT=gpt-4o
ENABLE_SEMANTIC_METADATA=false