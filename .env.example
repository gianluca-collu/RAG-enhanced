# Copy to .env and replace placeholders with your own Azure resource values.
OPENAI_URL=https://YOUR-OPENAI-RESOURCE.openai.azure.com/
OPENAI_KEY=replace-with-azure-openai-key
OPENAI_MODEL=gpt-4o
OPENAI_DEPLOYMENT_NAME=your-chat-deployment
OPENAI_API_VERSION=2024-10-21

SEARCH_URL=https://YOUR-SEARCH-SERVICE.search.windows.net/
SEARCH_KEY=replace-with-azure-search-key
INDEX_NAME=rag-documents

EMBEDDING_MODEL=text-embedding-ada-002
EMBEDDING_DEPLOYMENT_NAME=your-embedding-deployment
EMBEDDING_DIMENSIONS=1536

API_KEY=replace-with-a-long-random-api-token
AUTH_REQUIRED=false
ALLOWED_USER_EMAILS=
OIDC_REDIRECT_URI=
OIDC_COOKIE_SECRET=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_METADATA_URL=

DOCUMENT_INTELLIGENCE_ENDPOINT=https://YOUR-DOCUMENT-INTELLIGENCE.cognitiveservices.azure.com/
DOCUMENT_INTELLIGENCE_KEY=replace-with-document-intelligence-key
ENABLE_VISION=false
VISION_DEPLOYMENT=gpt-4o
ENABLE_SEMANTIC_METADATA=false
